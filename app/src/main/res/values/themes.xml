<resources>
    <style name="Theme.TruyenReader" parent="Theme.Material3.Dark">
        <item name="colorPrimary">#7C6CFF</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#2A2456</item>
        <item name="colorOnPrimaryContainer">#DCD6FF</item>
        <item name="colorSecondary">#22D3EE</item>
        <item name="colorSurface">#12121A</item>
        <item name="colorOnSurface">#F2F2F5</item>
        <item name="colorSurfaceVariant">#1E1E28</item>
        <item name="colorOnSurfaceVariant">#A7A5B5</item>
        <item name="android:colorBackground">#0A0A0F</item>
        <item name="android:windowBackground">#0A0A0F</item>
        <item name="android:statusBarColor">#0A0A0F</item>
        <item name="android:navigationBarColor">#0D0D14</item>
    </style>

    <style name="BottomTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">3dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
