<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_bar"
        app:navigationIcon="@mipmap/ic_launcher_round"
        app:title="PhimHub"
        app:titleTextColor="@color/text_primary"
        app:titleMarginStart="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/hairline" />

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/hairline" />

    <!-- Thanh tab tu dung: BottomNavigationView cua Material chi cho toi da
         5 muc. MainActivity tu xu ly bam + to mau icon/the dang chon. -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_bar"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabHome"
            style="@style/BottomTab"
            android:drawableTop="@drawable/ic_tab_home"
            android:text="Trang chủ" />

        <TextView
            android:id="@+id/tabSingle"
            style="@style/BottomTab"
            android:drawableTop="@drawable/ic_tab_movie"
            android:text="Phim lẻ" />

        <TextView
            android:id="@+id/tabSeries"
            style="@style/BottomTab"
            android:drawableTop="@drawable/ic_tab_series"
            android:text="Phim bộ" />

        <TextView
            android:id="@+id/tabCinema"
            style="@style/BottomTab"
            android:drawableTop="@drawable/ic_tab_cinema"
            android:text="Chiếu rạp" />

        <TextView
            android:id="@+id/tabFilter"
            style="@style/BottomTab"
            android:drawableTop="@drawable/ic_tab_filter"
            android:text="Lọc phim" />

        <TextView
            android:id="@+id/tabFavorites"
            style="@style/BottomTab"
            android:drawableTop="@drawable/ic_tab_star"
            android:text="Yêu thích" />

        <TextView
            android:id="@+id/tabHistory"
            style="@style/BottomTab"
            android:drawableTop="@drawable/ic_tab_history"
            android:text="Lịch sử" />
    </LinearLayout>
</LinearLayout>
