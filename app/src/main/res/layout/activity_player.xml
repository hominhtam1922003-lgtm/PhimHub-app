<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <WebView
        android:id="@+id/wvPlayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Player goc cho luong thang (m3u8/mp4): giai ma phan cung +
         dem sau, phat muot hon han trinh phat WebView/hls.js cu.
         Trang embed van phat bang WebView o tren. -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/exoPlayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/playerProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnServer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:alpha="0.92"
        android:text="Server 1/1 ⟳"
        android:visibility="gone"
        app:backgroundTint="#26262F"
        app:cornerRadius="20dp" />
</FrameLayout>
